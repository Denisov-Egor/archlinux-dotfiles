{
    "layer": "top",
    "position": "top",

    "height": 40,

    "margin-top": 5,
    "margin-left": 8,
    "margin-right": 8,

    // =========================================================
    // MODULES
    // =========================================================

    "modules-left": [
        "hyprland/workspaces"
    ],

    "modules-center": [
        
    ],

    "modules-right": [
        "custom/layout",

        "custom/microphone",
        "pulseaudio",

        "network",
        "bluetooth",
        "battery",

        "cpu",
        "memory",
        "custom/vram",
        "temperature",

        "disk",
        "custom/uptime",

        "custom/notifications",

        "tray",
        "clock",
        "custom/power"
    ],

    "custom/layout": {
    "exec": "hyprctl devices -j | jq -r '.keyboards[] | select(.main == true) | .active_keymap' | grep -q 'Russian' && echo 'RU' || echo 'EN'",

    "interval": 1,

    "format": "󰌌 {}",

    "on-click": "hyprctl switchxkblayout current next",

    "tooltip": true,
    "tooltip-format": "Раскладка: {}\nЛКМ — переключить"
},

    // =========================================================
    // WORKSPACES
    // =========================================================

    "hyprland/workspaces": {
        "format": "{icon}",

        "format-icons": {
            "active": "",
            "default": "",
            "empty": ""
        },

        "persistent-workspaces": {
            "*": 5
        },

        "sort-by-number": true,

        "on-click": "activate",

        "on-scroll-up": "hyprctl dispatch workspace e+1",
        "on-scroll-down": "hyprctl dispatch workspace e-1",

        "tooltip": false
    },

    // =========================================================
    // LANGUAGE
    // =========================================================

    "hyprland/language": {
        "format": "{}",

        "format-en": "EN",
        "format-ru": "RU",

        "tooltip": true,

        "tooltip-format": "Раскладка: {}"
    },

    // =========================================================
    // MICROPHONE
    // =========================================================

    "custom/microphone": {
        "exec": "bash -c 'if wpctl get-volume @DEFAULT_AUDIO_SOURCE@ | grep -q MUTED; then echo \"\"; else echo \"\"; fi'",

        "interval": 1,

        "format": "{}",

        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle",

        "on-click-right": "pavucontrol",

        "tooltip": true,

        "tooltip-format": "Микрофон\nЛКМ — mute/unmute\nПКМ — настройки"
    },

    // =========================================================
    // VOLUME
    // =========================================================

    "pulseaudio": {
        "format": "{icon} {volume}%",

        "format-muted": "󰖁",

        "format-icons": {
            "default": [
                "",
                "",
                ""
            ]
        },

        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",

        "on-click-right": "pavucontrol",

        "on-scroll-up": "wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+",

        "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-",

        "tooltip": true,

        "tooltip-format": "Громкость: {volume}%\nЛКМ — mute\nПКМ — настройки"
    },

    // =========================================================
    // NETWORK
    // =========================================================

    "network": {
        "format-wifi": "󰖩 {signalStrength}%",

        "format-ethernet": "󰈀",

        "format-disconnected": "󰖪",

        "tooltip-format-wifi": "{essid}\nSignal: {signalStrength}%\nIP: {ipaddr}",

        "tooltip-format-ethernet": "Ethernet\nIP: {ipaddr}",

        "tooltip-format-disconnected": "Нет подключения",

        "on-click": "nm-connection-editor",

        "on-click-right": "kitty -e nmtui"
    },

    // =========================================================
    // BLUETOOTH
    // =========================================================

    "bluetooth": {
        "format": "󰂯",

        "format-disabled": "󰂲",

        "format-off": "󰂲",

        "format-connected": "󰂱",

        "tooltip-format": "Bluetooth\n{status}",

        "on-click": "blueman-manager"
    },

    // =========================================================
    // BATTERY
    // =========================================================

    "battery": {
        "interval": 5,

        "format": "{icon} {capacity}%",

        "format-charging": "󰂄 {capacity}%",

        "format-plugged": "󰚥 {capacity}%",

        "format-icons": [
            "󰂎",
            "󰁺",
            "󰁻",
            "󰁼",
            "󰁽",
            "󰁾",
            "󰁿",
            "󰂀",
            "󰂁",
            "󰂂",
            "󰁹"
        ],

        "states": {
            "warning": 30,
            "critical": 15
        },

        "on-click": "kitty -e bash -c 'upower -i $(upower -e | grep BAT); read'",

        "tooltip": true
    },

    // =========================================================
    // CPU
    // =========================================================

    "cpu": {
        "interval": 2,

        "format": " {usage}%",

        "on-click": "kitty -e btop",

        "tooltip": true,

        "tooltip-format": "CPU\nИспользование: {usage}%\nЛКМ — btop"
    },

    // =========================================================
    // RAM
    // =========================================================

    "memory": {
        "interval": 3,

        "format": "󰘚 {percentage}%",

        "on-click": "kitty -e btop",

        "tooltip": true,

        "tooltip-format": "RAM\nИспользовано: {used:0.1f}G\nДоступно: {avail:0.1f}G\nЛКМ — btop"
    },

    // =========================================================
    // VRAM
    // =========================================================

    "custom/vram": {
        "exec": "bash -c 'if command -v nvidia-smi >/dev/null 2>&1; then nvidia-smi --query-gpu=memory.used,memory.total --format=csv,noheader,nounits | head -1 | awk -F\", \" \"{printf \\\"VRAM %.1f/%.1fG\\\", \\$1/1024, \\$2/1024}\"; else echo \"VRAM N/A\"; fi'",

        "interval": 3,

        "on-click": "kitty -e watch -n 1 nvidia-smi",

        "tooltip": true,

        "tooltip-format": "VRAM\nЛКМ — nvidia-smi"
    },

    // =========================================================
    // TEMPERATURE
    // =========================================================

    "temperature": {
        "interval": 5,

        "format": " {temperatureC}°",

        "critical-threshold": 80,

        "format-icons": [
            "",
            "",
            ""
        ],

        "on-click": "kitty -e bash -c 'sensors; read'",

        "tooltip": true,

        "tooltip-format": "Температура: {temperatureC}°C\nЛКМ — sensors"
    },

    // =========================================================
    // DISK
    // =========================================================

    "disk": {
        "interval": 30,

        "path": "/",

        "format": " {percentage_used}%",

        "on-click": "kitty -e bash -c 'df -h; read'",

        "on-click-right": "kitty -e ncdu /",

        "tooltip": true,

        "tooltip-format": "Disk\nИспользовано: {used}\nСвободно: {free}\nЛКМ — df\nПКМ — ncdu"
    },

    // =========================================================
    // UPTIME
    // =========================================================

    "custom/uptime": {
        "exec": "uptime -p | sed 's/up //'",

        "interval": 30,

        "format": "󱎫 {}",

        "on-click": "kitty -e bash -c 'uptime; read'",

        "tooltip": true,

        "tooltip-format": "Время работы системы"
    },

    // =========================================================
    // NOTIFICATIONS
    // =========================================================

    "custom/notifications": {
        "exec": "swaync-client -c 2>/dev/null || echo 0",

        "interval": 2,

        "format": "󰂚 {}",

        "on-click": "swaync-client -t",

        "on-click-right": "swaync-client -C",

        "tooltip": true,

        "tooltip-format": "Уведомления\nЛКМ — открыть\nПКМ — очистить"
    },

    // =========================================================
    // SYSTEM TRAY
    // =========================================================

    "tray": {
        "icon-size": 16,

        "spacing": 6,

        "show-passive-items": true
    },

    // =========================================================
    // CLOCK
    // =========================================================

    "clock": {
        "interval": 1,

        "format": " {:%H:%M}",

        "format-alt": " {:%d.%m.%Y}",

        "tooltip-format": "{:%A, %d %B %Y\n%H:%M:%S}",

        "on-click": "kitty -e cal",

        "on-click-right": "date"
    },

    // =========================================================
    // POWER
    // =========================================================

    "custom/power": {
        "format": "⏻",

        "on-click": "wlogout",

        "tooltip": true,

        "tooltip-format": "Power menu"
    }
}