{
  // ============================================================
  // TERMINAL — настройки встроенного терминала VS Code
  // ============================================================

  // Использовать Bash как терминал по умолчанию в Linux.
  "terminal.integrated.defaultProfile.linux": "bash",

  // Плавная прокрутка терминала.
  "terminal.integrated.smoothScrolling": true,

  // Включить мигание курсора терминала.
  "terminal.integrated.cursorBlinking": true,

  // Форма курсора терминала — вертикальная линия.
  "terminal.integrated.cursorStyle": "line",

  // Шрифт терминала — JetBrains Mono.
  "terminal.integrated.fontFamily": "JetBrains Mono",

  // Размер шрифта терминала — 13 px.
  "terminal.integrated.fontSize": 13,

  // Межстрочный интервал терминала.
  "terminal.integrated.lineHeight": 1.4,

  // ============================================================
  // EDITOR — базовые настройки редактора кода
  // ============================================================

  // Основной шрифт редактора — JetBrains Mono.
  // monospace используется как запасной вариант.
  "editor.fontFamily": "'JetBrains Mono', monospace",

  // Размер шрифта редактора — 14 px.
  "editor.fontSize": 14,

  // Обычная толщина шрифта.
  // 400 = Regular.
  "editor.fontWeight": "400",

  // Межстрочный интервал — 1.55 от размера шрифта.
  "editor.lineHeight": 1.55,

  // Включить лигатуры JetBrains Mono.
  // Например, => и != могут визуально объединяться.
  "editor.fontLigatures": false,

  // ============================================================
  // FILES — сохранение файлов
  // ============================================================

  // Автоматически сохранять изменённые файлы.
  "files.autoSave": "afterDelay",

  // Сохранять через 1 секунду после изменения.
  "files.autoSaveDelay": 1000,

  // ============================================================
  // INDENTATION — отступы
  // ============================================================

  // Размер одного уровня отступа — 2 пробела.
  "editor.tabSize": 2,

  // Использовать пробелы вместо символов Tab.
  "editor.insertSpaces": true,

  // Не определять размер отступа автоматически.
  "editor.detectIndentation": false,

  // Не переносить длинные строки автоматически.
  "editor.wordWrap": "off",


  // ============================================================
  // SCROLLING & CURSOR — прокрутка и курсор редактора
  // ============================================================

  // Включить плавную прокрутку редактора.
  "editor.smoothScrolling": true,

  // Плавная анимация движения текстового курсора.
  "editor.cursorSmoothCaretAnimation": "on",

  // Разрешить изменение масштаба редактора колёсиком мыши + Ctrl.
  "editor.mouseWheelZoom": true,


  // ============================================================
  // SCROLLBAR — полосы прокрутки
  // ============================================================

  // Показывать горизонтальную полосу прокрутки.
  "editor.scrollbar.horizontal": "visible",

  // Показывать вертикальную полосу прокрутки.
  "editor.scrollbar.vertical": "visible",

  // Толщина горизонтального scrollbar — 6 px.
  "editor.scrollbar.horizontalScrollbarSize": 6,

  // Толщина вертикального scrollbar — 7 px.
  "editor.scrollbar.verticalScrollbarSize": 7,


  // ============================================================
  // CURSOR — курсор редактора
  // ============================================================

  // Плавное мигание курсора.
  "editor.cursorBlinking": "smooth",

  // Толщина курсора — 2 px.
  "editor.cursorWidth": 2,


  // ============================================================
  // MINIMAP / OVERVIEW — дополнительные визуальные элементы
  // ============================================================

  // Отключить Minimap справа от кода.
  "editor.minimap.enabled": false,

  // Убрать рамку вокруг Overview Ruler.
  "editor.overviewRulerBorder": false,

  // Не показывать курсор в Overview Ruler.
  "editor.hideCursorInOverviewRuler": true,


  // ============================================================
  // BRACKETS / HIGHLIGHTING — подсветка кода
  // ============================================================

  // Не подсвечивать парные скобки при наведении.
  "editor.matchBrackets": "never",

  // Включить цветную подсветку уровней скобок.
  "editor.bracketPairColorization.enabled": true,

  // Не подсвечивать все одинаковые вхождения выбранного слова.
  "editor.occurrencesHighlight": "off",


  // ============================================================
  // SNIPPETS — подсказки сниппетов
  // ============================================================

  // Показывать сниппеты в верхней части списка автодополнения.
  "editor.snippetSuggestions": "top",


  // ============================================================
  // WHITESPACE — пробелы и управляющие символы
  // ============================================================

  // Показывать пробелы и Tab только при выделении текста.
  "editor.renderWhitespace": "selection",

  // Не отображать управляющие символы.
  "editor.renderControlCharacters": false,


  // ============================================================
  // GUIDES — направляющие
  // ============================================================

  // Включить вертикальные линии уровней отступов.
  "editor.guides.indentation": true,

  // Отключить направляющие парных скобок.
  "editor.guides.bracketPairs": false,


  // ============================================================
  // EDITOR PADDING — внутренние отступы редактора
  // ============================================================

  // Отступ сверху от первой строки кода.
  "editor.padding.top": 6,

  // Отступ снизу после последней строки.
  "editor.padding.bottom": 6,

  // Отключить Sticky Scroll.
  // Заголовки функций/классов не остаются сверху.
  "editor.stickyScroll.enabled": false,

  // Для Mac используется Cmd, для Linux/Windows — Ctrl.
  // Определяет модификатор для мультикурсора.
  "editor.multiCursorModifier": "ctrlCmd",


  // ============================================================
  // WORKBENCH — основное оформление VS Code
  // ============================================================

  // Основная цветовая тема — Kanagawa Wave.
  "workbench.colorTheme": "Kanagawa Wave",

  // Тема иконок файлов — Flow Deep.
  "workbench.iconTheme": "flow-deep",

  // Переместить Activity Bar наверх.
  "workbench.activityBar.location": "top",

  // ПОказывать Status Bar.
  "workbench.statusBar.visible": true,

  // WakaTime — показывать время программирования в Status Bar.
  "wakatime.statusBarCodingActivity": true,

  // Разместить WakaTime справа.
  "wakatime.align": "right",

  // Приоритет позиции WakaTime.
  "wakatime.alignPriority": 100,

  // Расстояние между уровнями файлов в Explorer.
  "workbench.tree.indent": 16,

  // Плавная прокрутка списков VS Code.
  "workbench.list.smoothScrolling": true,

  // Не показывать советы VS Code.
  "workbench.tips.enabled": false,

  // Скрыть подсказку на пустой вкладке редактора.
  "workbench.editor.empty.hint": "hidden",


  // ============================================================
  // TABS — вкладки файлов
  // ============================================================

  // Показывать вкладки, если открыто несколько файлов.
  "workbench.editor.showTabs": "multiple",

  // Автоматически уменьшать ширину вкладок.
  "workbench.editor.tabSizing": "shrink",

  // Включить кнопку закрытия с вкладок.
  "workbench.editor.showTabCloseButton": "always",

  // Расположить действия вкладок справа.
  "workbench.editor.tabActionLocation": "right",

  // ============================================================
  // BROWSER / WINDOW — окно VS Code
  // ============================================================

  // Показывать встроенный браузер в title bar.
  "workbench.browser.showInTitleBar": true,

  // Использовать собственный title bar VS Code.
  "window.titleBarStyle": "custom",

  // Увеличить интерфейс VS Code на 0.5 уровня.
  // Влияет на масштаб всего интерфейса.
  "window.zoomLevel": 0.5,


  // ============================================================
  // EXPLORER — файловый менеджер VS Code
  // ============================================================

  // Требовать подтверждение перед Drag & Drop файлов.
  "explorer.confirmDragAndDrop": true,

  // Требовать подтверждение перед удалением файлов.
  "explorer.confirmDelete": true,

  // Отключить badges рядом с файлами.
  "explorer.decorations.badges": false,

  // Отключить цветовые индикаторы файлов.
  "explorer.decorations.colors": false,


  // ============================================================
  // GIT — интеграция Git
  // ============================================================

  // Включить Git-декорации в Explorer.
  "git.decorations.enabled": true,

  // Включить diff-индикаторы в редакторе.
  "scm.diffDecorations": "all",

  // Автоматически получать изменения с удалённого Git-репозитория.
  "git.autofetch": true,

  // Разрешить Smart Commit без предварительного stage.
  "git.enableSmartCommit": true,

  // Не спрашивать подтверждение при Sync.
  "git.confirmSync": false,


  // ============================================================
  // CHAT — встроенный AI Chat VS Code
  // ============================================================

  // Не показывать список сохранённых Chat-сессий.
  "chat.viewSessions.enabled": false,

  // Не показывать информацию об использовании контекстного окна.
  "chat.contextUsage.enabled": false,


  // ============================================================
  // EXTENSIONS — расширения
  // ============================================================

  // Не показывать рекомендации по расширениям.
  "extensions.ignoreRecommendations": true,

  // Включить Todo Tree.
  // Позволяет находить TODO / FIXME и другие маркеры.
  "todo-tree.highlights.enabled": true,


  // ============================================================
  // EXCALIDRAW — настройки Excalidraw
  // ============================================================

  // Хранить библиотеку Excalidraw в текущей директории проекта.
  "excalidraw.workspaceLibraryPath": ".",

  // Использовать тёмную тему Excalidraw.
  "excalidraw.theme": "dark",


  // ============================================================
  // SECURITY — безопасность Workspace
  // ============================================================

  // Открывать неподтверждённые файлы в новом окне.
  // Это уменьшает риск выполнения кода из недоверенного проекта.
  "security.workspace.trust.untrustedFiles": "newWindow",


  // ============================================================
  // DEBUG — отладчик
  // ============================================================

  // При ошибке задачи показывать ошибки.
  "debug.onTaskErrors": "showErrors",


  // ============================================================
  // GLASSIT — прозрачность VS Code
  // ============================================================

  // Полностью непрозрачное окно.
  // 1 = 100% opacity.
  "glassit.alpha": 1,

  // Использовать интеграцию GlassIt с Sway.
  "glassit.force_sway": true,


  // ============================================================
  // COLOR CUSTOMIZATIONS — цветовая схема интерфейса
  // ============================================================

  "workbench.colorCustomizations": {

    // ------------------------------------------------------------
    // EDITOR
    // ------------------------------------------------------------

    // Основной фон редактора.
    "editor.background": "#1F1F28",

    // Основной цвет текста.
    "editor.foreground": "#DCD7BA",

    // Фон области gutter слева от кода.
    "editorGutter.background": "#1F1F28",

    // Цвет обычных номеров строк.
    "editorLineNumber.foreground": "#54546D",

    // Цвет номера активной строки.
    "editorLineNumber.activeForeground": "#727169",

    // Цвет курсора.
    "editorCursor.foreground": "#7E9CD8",

    // Цвет выделенного текста.
    "editor.selectionBackground": "#2D4F67",

    // Цвет выделения в неактивной области редактора.
   "editor.inactiveSelectionBackground": "#00000000",

    // Фон текущей строки.
    "editor.lineHighlightBackground": "#222230",

    // Убрать рамку текущей строки.
    "editor.lineHighlightBorder": "#00000000",

    // Цвет отображаемых пробелов.
    "editorWhitespace.foreground": "#363646",

    // Цвет обычных направляющих отступов.
    "editorIndentGuide.background1": "#2A2A37",

    // Цвет активной направляющей отступа.
    "editorIndentGuide.activeBackground1": "#54546D",


    // ------------------------------------------------------------
    // BRACKETS
    // ------------------------------------------------------------

    // Цвет первого уровня скобок.
    "editorBracketHighlight.foreground1": "#7E9CD8",

    // Цвет второго уровня скобок.
    "editorBracketHighlight.foreground2": "#98BB6C",

    // Цвет третьего уровня скобок.
    "editorBracketHighlight.foreground3": "#E6C384",


    // ------------------------------------------------------------
    // OVERVIEW RULER / SCROLLBAR
    // ------------------------------------------------------------

    // Убрать рамку Overview Ruler.
    "editorOverviewRuler.border": "#00000000",

    // Цвет ползунка scrollbar.
    // Последние 2 символа — прозрачность.
    "scrollbarSlider.background": "#54546D66",

    // Цвет scrollbar при наведении.
    "scrollbarSlider.hoverBackground": "#72716988",

    // Цвет scrollbar при нажатии.
    "scrollbarSlider.activeBackground": "#7E9CD899",


    // ------------------------------------------------------------
    // SIDEBAR
    // ------------------------------------------------------------

    // Фон боковой панели.
    "sideBar.background": "#1A1A22",

    // Основной цвет текста боковой панели.
    "sideBar.foreground": "#C8C093",

    // Убрать границу Sidebar.
    "sideBar.border": "#00000000",

    // Фон заголовков секций Sidebar.
    "sideBarSectionHeader.background": "#1F1F28",

    // Цвет текста заголовков секций Sidebar.
    "sideBarSectionHeader.foreground": "#DCD7BA",


    // ------------------------------------------------------------
    // ACTIVITY BAR
    // ------------------------------------------------------------

    // Фон верхней Activity Bar.
    "activityBar.background": "#181820",

    // Цвет активных иконок.
    "activityBar.foreground": "#DCD7BA",

    // Цвет неактивных иконок.
    "activityBar.inactiveForeground": "#54546D",

    // Цвет индикатора активного раздела.
    "activityBar.activeBorder": "#7E9CD8",

    // Убрать границу Activity Bar.
    "activityBar.border": "#00000000",


    // ------------------------------------------------------------
    // TITLE BAR
    // ------------------------------------------------------------

    // Фон активного окна.
    "titleBar.activeBackground": "#181820",

    // Фон неактивного окна.
    "titleBar.inactiveBackground": "#181820",

    // Цвет текста активного окна.
    "titleBar.activeForeground": "#DCD7BA",

    // Цвет текста неактивного окна.
    "titleBar.inactiveForeground": "#727169",


    // ------------------------------------------------------------
    // TABS
    // ------------------------------------------------------------

    // Фон активной вкладки.
    "tab.activeBackground": "#1F1F28",

    // Фон неактивной вкладки.
    "tab.inactiveBackground": "#181820",

    // Цвет текста активной вкладки.
    "tab.activeForeground": "#DCD7BA",

    // Цвет текста неактивной вкладки.
    "tab.inactiveForeground": "#727169",

    // Убрать границу вкладок.
    "tab.border": "#00000000",

    // Верхний индикатор активной вкладки.
    "tab.activeBorderTop": "#7E9CD8",


    // ------------------------------------------------------------
    // EDITOR GROUPS
    // ------------------------------------------------------------

    // Фон области вкладок редактора.
    "editorGroupHeader.tabsBackground": "#181820",

    // Фон группы без вкладок.
    "editorGroupHeader.noTabsBackground": "#181820",

    // Граница между группами редактора.
    "editorGroup.border": "#2A2A37",


    // ------------------------------------------------------------
    // PANEL
    // ------------------------------------------------------------

    // Фон нижней панели.
    "panel.background": "#181820",

    // Граница панели.
    "panel.border": "#2A2A37",


    // ------------------------------------------------------------
    // TERMINAL
    // ------------------------------------------------------------

    // Фон терминала.
    "terminal.background": "#181820",

    // Цвет текста терминала.
    "terminal.foreground": "#DCD7BA",

    // Цвет курсора терминала.
    "terminalCursor.foreground": "#7E9CD8",

    // Граница терминала.
    "terminal.border": "#2A2A37",


    // ------------------------------------------------------------
    // INPUTS
    // ------------------------------------------------------------

    // Фон текстовых полей.
    "input.background": "#222230",

    // Цвет текста в текстовых полях.
    "input.foreground": "#DCD7BA",

    // Граница текстовых полей.
    "input.border": "#363646",

    // Цвет placeholder-текста.
    "input.placeholderForeground": "#727169",


    // ------------------------------------------------------------
    // DROPDOWNS
    // ------------------------------------------------------------

    // Фон выпадающих списков.
    "dropdown.background": "#222230",

    // Цвет текста выпадающих списков.
    "dropdown.foreground": "#DCD7BA",

    // Граница выпадающих списков.
    "dropdown.border": "#363646",


    // ------------------------------------------------------------
    // LISTS — списки Explorer / Quick Open и т.д.
    // ------------------------------------------------------------

    // Фон выбранного элемента.
    "list.activeSelectionBackground": "#2D4F67",

    // Цвет текста выбранного элемента.
    "list.activeSelectionForeground": "#DCD7BA",

    // Фон выбранного элемента в неактивном списке.
    "list.inactiveSelectionBackground": "#223249",

    // Фон элемента при наведении мыши.
    "list.hoverBackground": "#222230",

    // Фон элемента, имеющего keyboard focus.
    "list.focusBackground": "#2A2A37",


    // ------------------------------------------------------------
    // QUICK INPUT
    // ------------------------------------------------------------

    // Фон Command Palette и Quick Open.
    "quickInput.background": "#1F1F28",

    // Цвет текста Command Palette.
    "quickInput.foreground": "#DCD7BA",


    // ------------------------------------------------------------
    // MENUS
    // ------------------------------------------------------------

    // Фон контекстных меню.
    "menu.background": "#1F1F28",

    // Цвет текста меню.
    "menu.foreground": "#DCD7BA",

    // Фон выбранного пункта меню.
    "menu.selectionBackground": "#2D4F67",

    // Цвет текста выбранного пункта.
    "menu.selectionForeground": "#DCD7BA",

    // Цвет разделителей меню.
    "menu.separatorBackground": "#363646",


    // ------------------------------------------------------------
    // NOTIFICATIONS
    // ------------------------------------------------------------

    // Фон заголовка Notification Center.
    "notificationCenterHeader.background": "#181820",

    // Фон уведомлений.
    "notifications.background": "#1F1F28",

    // Цвет текста уведомлений.
    "notifications.foreground": "#DCD7BA",

    // Цвет иконки ошибки.
    "notificationsErrorIcon.foreground": "#D27E99",

    // Цвет иконки предупреждения.
    "notificationsWarningIcon.foreground": "#E6C384",

    // Цвет информационной иконки.
    "notificationsInfoIcon.foreground": "#7E9CD8",


    // ------------------------------------------------------------
    // BUTTONS
    // ------------------------------------------------------------

    // Основной фон кнопок.
    "button.background": "#2D4F67",

    // Цвет текста кнопок.
    "button.foreground": "#DCD7BA",

    // Фон кнопки при наведении.
    "button.hoverBackground": "#36566F",


    // ------------------------------------------------------------
    // BADGES
    // ------------------------------------------------------------

    // Фон небольших badge-индикаторов.
    "badge.background": "#54546D",

    // Цвет текста badge.
    "badge.foreground": "#DCD7BA",


    // ------------------------------------------------------------
    // GLOBAL UI
    // ------------------------------------------------------------

    // Цвет рамки при фокусе.
    // 66 в конце = частичная прозрачность.
    "focusBorder": "#7E9CD866",

    // Основной цвет интерфейсного текста.
    "foreground": "#DCD7BA",

    // Цвет второстепенного / описательного текста.
    "descriptionForeground": "#727169"
  },


  // ============================================================
  // SYNTAX HIGHLIGHTING — цвета синтаксиса
  // ============================================================

  "editor.tokenColorCustomizations": {
    "[Kanagawa Wave]": {
      "textMateRules": [
        {
          "scope": "comment",
          "settings": {
            "foreground": "#727169",
            "fontStyle": "italic"
          }
          },
            {
                "scope": "string",
                "settings": {
                    "foreground": "#98BB6C"
                }
            },
            {
                "scope": "keyword",
                "settings": {
                    "foreground": "#957FB8"
                }
            },
            {
                "scope": "constant.numeric",
                "settings": {
                    "foreground": "#D27E99"
                }
            },
            {
                "scope": [
                    "entity.name.function",
                    "meta.function-call"
                ],
                "settings": {
                    "foreground": "#7E9CD8"
                }
            },
            {
                "scope": [
                    "storage.type",
                    "entity.name.type",
                    "support.type"
                ],
                "settings": {
                    "foreground": "#7AA89F"
                }
            },
            {
                "scope": "variable",
                "settings": {
                    "foreground": "#DCD7BA"
                }
            },
            {
                "scope": "constant.language",
                "settings": {
                    "foreground": "#E6C384"
                }
            }
        ]
    }

  },

  // ============================================================
  // CUSTOM CSS / ANIMATIONS
  // ============================================================

  // Подключить JavaScript-файл расширения vscode-animations.
  // Он отвечает за дополнительные визуальные анимации VS Code.
}
